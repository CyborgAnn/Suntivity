<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="844" prefWidth="390" style="-fx-background-color:#A8E6A3;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.suntivity.controller.ChildDashboardController">


    <!-- ================= TOP ================= -->

    <top>

        <VBox alignment="CENTER" prefHeight="114.0" prefWidth="390.0" spacing="10">

            <padding>
                <Insets bottom="15" top="20" />
            </padding>


            <!-- Suntivity Logo -->
            <ImageView fx:id="logoImageView" fitHeight="60.0" fitWidth="215.0" preserveRatio="true">

                <image>

                    <Image url="@../DataFiles/SuntivityDesigns/AppArt/AppName2.png" />

                </image>

            </ImageView>



            <!-- Welcome Message -->
            <Label fx:id="welcomeLabel" text="Welcome!" textFill="#035e1b">

                <font>
                    <Font size="24" />
                </font>

            </Label>


        </VBox>


    </top>




    <!-- ================= CENTER ================= -->

    <center>

        <VBox alignment="TOP_CENTER" prefHeight="626.0" prefWidth="390.0" spacing="10" VBox.vgrow="ALWAYS">

            <padding>

                <Insets bottom="10" left="20" right="20" top="10" />

            </padding>



            <!-- CUSTOMIZED PLANT DISPLAY -->

            <StackPane fx:id="plantDisplayPane" prefHeight="199.0" prefWidth="318.0">


                <!-- Face -->
                <ImageView fx:id="faceImageView" fitHeight="36.0" fitWidth="40.0" preserveRatio="true" translateY="-95.0" />



                <!-- Plant Stage Image -->
                <ImageView fx:id="plantImageView" fitHeight="149.0" fitWidth="105.0" preserveRatio="true" />



                <!-- Plant Pot -->
                <ImageView fx:id="boxImageView" fitHeight="40.0" fitWidth="91.0" preserveRatio="true" translateY="115.0" />


            </StackPane>





            <!-- Plant Status -->

            <Label fx:id="plantStageLabel" text="Plant Stage: Seedling" textFill="#035e1b">

                <font>

                    <Font size="18" />

                </font>

            </Label>





            <!-- Points -->

            <Label fx:id="pointsLabel" text="Points: 0" textFill="#035e1b">

                <font>

                    <Font size="18" />

                </font>

            </Label>






            <!-- Calendar Month -->

            <Label fx:id="monthLabel" text="July 2026" textFill="#035e1b">


                <font>

                    <Font size="16" />

                </font>


            </Label>





            <!-- Calendar -->

            <GridPane fx:id="calendarGrid" alignment="CENTER" hgap="3" scaleX="0.85" scaleY="0.85" vgap="3">
            </GridPane>





            <Separator />






            <!-- Tasks -->

            <Label text="My Tasks">

                <font>

                    <Font size="20" />

                </font>

            </Label>




            <ListView fx:id="taskListView" prefHeight="197.0" prefWidth="322.0" VBox.vgrow="ALWAYS" />





            <Button fx:id="completeTaskButton" onAction="#completeTask" prefWidth="200" style="-fx-background-radius: 15; -fx-background-color: #215427;" text="Mark As Completed" textFill="WHITE">


                <font>

                    <Font size="16" />

                </font>


            </Button>



        </VBox>


    </center>







    <!-- ================= BOTTOM ================= -->


    <bottom>

        <VBox alignment="CENTER" spacing="10">

            <padding>
                <Insets bottom="20" top="10" />
            </padding>


            <HBox alignment="CENTER" spacing="20">


                <Button onAction="#openShop" prefWidth="100" style="-fx-background-color: #8035ab; -fx-background-radius: 15;" styleClass="col" text="Shop" textFill="WHITE" />


                <Button onAction="#logout" prefWidth="100" style="-fx-background-radius: 15;" text="Logout" textFill="#030303" />


            </HBox>


        </VBox>

    </bottom>



</BorderPane>
